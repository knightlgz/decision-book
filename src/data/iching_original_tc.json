        "scripture": "幹母之蠱，不可貞。"
      },
      {
        "name": "九三",
        "scripture": "幹父之蠱，小有悔，无大咎。"
      },
      {
        "name": "六四",
        "scripture": "裕父之蠱，往見吝。"
      },
      {
        "name": "六五",
        "scripture": "幹父之蠱，用譽。"
      },
      {
        "name": "上九",
        "scripture": "不事王侯，高尚其事。"
      }
    ]
  },
