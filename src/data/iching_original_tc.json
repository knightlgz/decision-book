      "巽"
    ],
    "scripture": "亨。密雲不雨，自我西郊。",
    "lines": [
      {
        "name": "初九",
        "scripture": "復自道，何其咎，吉。"
      },
      {
        "name": "九二",
        "scripture": "牽復，吉。"
      },
      {
        "name": "九三",
        "scripture": "輿說輻，夫妻反目。"
      },
      {
        "name": "六四",
        "scripture": "有孚，血去惕出，无咎。"
      },
      {
        "name": "九五",
        "scripture": "有孚攣如，富以其鄰。"
      },
      {
        "name": "上九",
        "scripture": "既雨既處，尚德載，婦貞厲。月幾望，君子征凶。"
      }
    ]
  },
  {
