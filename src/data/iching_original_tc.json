    "lines": [
      {
        "name": "初六",
        "scripture": "拔茅茹，以其彙，貞吉亨。"
      },
      {
        "name": "六二",
        "scripture": "包承。小人吉，大人否，亨。"
      },
      {
        "name": "六三",
        "scripture": "包羞。"
      },
      {
        "name": "九四",
        "scripture": "有命，无咎，疇離祉。"
      },
      {
        "name": "九五",
        "scripture": "休否，大人吉。其亡其亡，繫于苞桑。"
      },
      {
        "name": "上九",
        "scripture": "傾否，先否後喜。"
      }
    ]
  },
