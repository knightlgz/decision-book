      0
    ],
    "combination": [
      "坤",
      "坤"
    ],
    "scripture": "元亨，利牝馬之貞。君子有攸往，先迷後得主，利西南得朋，東北喪朋。安貞，吉。",
    "lines": [
      {
        "name": "初六",
        "scripture": "履霜，堅冰至。"
      },
      {
        "name": "六二",
        "scripture": "直，方，大，不習无不利。"
      },
      {
        "name": "六三",
        "scripture": "含章可貞。或從王事，无成有終。"
      },
      {
        "name": "六四",
        "scripture": "括囊；无咎，无譽。"
      },
      {
        "name": "六五",
        "scripture": "黃裳，元吉。"
      },
      {
        "name": "上六",
        "scripture": "龍戰于野，其血玄黃。"
      },
      {
        "name": "用六",
        "scripture": "利永貞。"
      }
    ]
  },
  {
    "id": 3,
    "name": "水雷屯",
    "symbol": "䷂",
    "array": [
