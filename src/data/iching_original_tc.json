    "lines": [
      {
        "name": "初六",
        "scripture": "鳴豫，凶。"
      },
      {
        "name": "六二",
        "scripture": "介于石，不終日，貞吉。"
      },
      {
        "name": "六三",
        "scripture": "盱豫，悔。遲有悔。"
      },
      {
        "name": "九四",
        "scripture": "由豫，大有得。勿疑。朋盍簪。"
      },
      {
        "name": "六五",
        "scripture": "貞疾，恆不死。"
      },
      {
        "name": "上六",
        "scripture": "冥豫，成有渝，无咎。"
      }
    ]
  },
