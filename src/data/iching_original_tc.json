    "lines": [
      {
        "name": "初九",
        "scripture": "同人于門，无咎。"
      },
      {
        "name": "六二",
        "scripture": "同人于宗，吝。"
      },
      {
        "name": "九三",
        "scripture": "伏戎于莽，升其高陵，三歲不興。"
      },
      {
        "name": "九四",
        "scripture": "乘其墉，弗克攻，吉。"
      },
      {
        "name": "九五",
        "scripture": "同人，先號咷而後笑。大師克相遇。"
      },
      {
        "name": "上九",
        "scripture": "同人于郊，无悔。"
      }
    ]
  },
