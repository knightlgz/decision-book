    "lines": [
      {
        "name": "初九",
        "scripture": "拔茅茹，以其彙，征吉。"
      },
      {
        "name": "九二",
        "scripture": "包荒，用馮河，不遐遺，朋亡，得尚于中行。"
      },
      {
        "name": "九三",
        "scripture": "无平不陂，无往不復，艱貞无咎。勿恤其孚，于食有福。"
      },
      {
        "name": "六四",
        "scripture": "翩翩，不富，以其鄰，不戒以孚。"
      },
      {
        "name": "六五",
        "scripture": "帝乙歸妹，以祉元吉。"
      },
      {
        "name": "上六",
        "scripture": "城復于隍，勿用師。自邑告命，貞吝。"
      }
    ]
  },
