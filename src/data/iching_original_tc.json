      0,
      0,
      0,
      1,
      0
    ],
    "combination": [
      "坤",
      "坎"
    ],
    "scripture": "吉。原筮元永貞，无咎。不寧方來，後夫凶。",
    "lines": [
      {
        "name": "初六",
        "scripture": "有孚，比之，无咎。有孚盈缶，終來有它吉。"
      },
      {
        "name": "六二",
        "scripture": "比之自內，貞吉。"
      },
      {
        "name": "六三",
        "scripture": "比之匪人。"
      },
      {
        "name": "六四",
        "scripture": "外比之，貞吉。"
      },
      {
        "name": "九五",
        "scripture": "顯比，王用三驅，失前禽。邑人不誡，吉。"
      },
      {
        "name": "上六",
        "scripture": "比之无首，凶。"
      }
    ]
  },
  {
