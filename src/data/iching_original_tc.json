      0,
      1,
      0
    ],
    "combination": [
      "震",
      "坎"
    ],
    "scripture": "元亨，利貞，勿用有攸往，利建侯。",
    "lines": [
      {
        "name": "初九",
        "scripture": "磐桓；利居貞，利建侯。"
      },
      {
        "name": "六二",
        "scripture": "屯如邅如，乘馬班如。匪寇婚媾，女子貞不字，十年乃字。"
      },
      {
        "name": "六三",
        "scripture": "即鹿无虞，惟入于林中，君子幾不如舍，往吝。"
      },
      {
        "name": "六四",
        "scripture": "乘馬班如，求婚媾，往吉，无不利。"
      },
      {
        "name": "九五",
        "scripture": "屯其膏，小貞吉，大貞凶。"
      },
      {
        "name": "上六",
        "scripture": "乘馬班如，泣血漣如。"
      }
    ]
  },
  {
    "id": 4,
    "name": "山水蒙",
    "symbol": "䷃",
    "array": [
      0,
      1,
      0,
      0,
      0,
      1
    ],
    "combination": [
      "坎",
      "艮"
    ],
    "scripture": "亨。匪我求童蒙，童蒙求我。初筮告，再三瀆，瀆則不告。利貞。",
    "lines": [
      {
        "name": "初六",
        "scripture": "發蒙，利用刑人，用說桎梏，以往吝。"
      },
      {
        "name": "九二",
        "scripture": "包蒙吉；納婦吉；子克家。"
      },
      {
        "name": "六三",
        "scripture": "勿用取女；見金夫，不有躬，无攸利。"
      },
      {
        "name": "六四",
        "scripture": "困蒙，吝。"
      },
      {
        "name": "六五",
        "scripture": "童蒙，吉。"
      },
      {
        "name": "上九",
        "scripture": "擊蒙；不利為寇，利禦寇。"
      }
    ]
  },
  {
    "id": 5,
    "name": "水天需",
    "symbol": "䷄",
    "array": [
      1,
      1,
      1,
      0,
      1,
      0
    ],
    "combination": [
      "乾",
      "坎"
    ],
    "scripture": "有孚，光亨，貞吉。利涉大川。",
    "lines": [
      {
        "name": "初九",
        "scripture": "需于郊。利用恆，无咎。"
      },
      {
        "name": "九二",
        "scripture": "需于沙。小有言，終吉。"
      },
      {
        "name": "九三",
        "scripture": "需于泥，致寇至。"
      },
      {
        "name": "六四",
        "scripture": "需于血，出自穴。"
      },
      {
        "name": "九五",
        "scripture": "需于酒食，貞吉。"
      },
      {
        "name": "上六",
        "scripture": "入于穴，有不速之客三人來，敬之終吉。"
      }
    ]
  },
  {
    "id": 6,
    "name": "天水訟",
    "symbol": "䷅",
    "array": [
      0,
      1,
      0,
      1,
      1,
      1
    ],
    "combination": [
      "坎",
      "乾"
    ],
    "scripture": "有孚，窒。惕中吉。終凶。利見大人，不利涉大川。",
    "lines": [
      {
        "name": "初六",
        "scripture": "不永所事，小有言，終吉。"
      },
      {
        "name": "九二",
        "scripture": "不克訟，歸而逋，其邑人三百戶，无眚。"
      },
      {
        "name": "六三",
        "scripture": "食舊德，貞厲，終吉，或從王事，无成。"
      },
      {
        "name": "九四",
        "scripture": "不克訟，復即命渝，安貞吉。"
      },
      {
        "name": "九五",
        "scripture": "訟元吉。"
      },
      {
        "name": "上九",
        "scripture": "或錫之鞶帶，終朝三褫之。"
      }
    ]
  },
  {
    "id": 7,
    "name": "地水師",
    "symbol": "䷆",
    "array": [
      0,
      1,
      0,
      0,
      0,
      0
    ],
    "combination": [
      "坎",
      "坤"
    ],
    "scripture": "貞，丈人，吉无咎。",
    "lines": [
      {
        "name": "初六",
        "scripture": "師出以律，否臧凶。"
      },
      {
        "name": "九二",
        "scripture": "在師中吉，无咎，王三錫命。"
      },
      {
        "name": "六三",
        "scripture": "師或輿尸，凶。"
      },
      {
        "name": "六四",
        "scripture": "師左次，无咎。"
      },
      {
        "name": "六五",
        "scripture": "田有禽，利執言，无咎。長子帥師，弟子輿尸，貞凶。"
      },
      {
        "name": "上六",
        "scripture": "大君有命，開國承家，小人勿用。"
      }
    ]
  },
  {
    "id": 8,
    "name": "水地比",
    "symbol": "䷇",
    "array": [
