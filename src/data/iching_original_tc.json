    ],
    "scripture": "元亨，利貞。",
    "lines": [
      {
        "name": "初九",
        "scripture": "潛龍，勿用。"
      },
      {
        "name": "九二",
        "scripture": "見龍在田，利見大人。"
      },
      {
        "name": "九三",
        "scripture": "君子終日乾乾，夕惕若，厲，无咎。"
      },
      {
        "name": "九四",
        "scripture": "或躍在淵，无咎。"
      },
      {
        "name": "九五",
        "scripture": "飛龍在天，利見大人。"
      },
      {
        "name": "上九",
        "scripture": "亢龍有悔。"
      },
      {
        "name": "用九",
        "scripture": "見群龍无首，吉。"
      }
    ]
  },
  {
    "id": 2,
    "name": "坤為地",
    "symbol": "䷁",
    "array": [
      0,
      0,
      0,
