    "scripture": "元亨利貞，无咎。",
    "lines": [
      {
        "name": "初九",
        "scripture": "官有渝，貞吉。出門交有功。"
      },
      {
        "name": "六二",
        "scripture": "系小子，失丈夫。"
      },
      {
        "name": "六三",
        "scripture": "系丈夫，失小子。隨有求得，利居貞。"
      },
      {
        "name": "九四",
        "scripture": "隨有獲，貞凶。有孚在道，以明，何咎。"
      },
      {
        "name": "九五",
        "scripture": "孚于嘉，吉。"
      },
      {
        "name": "上六",
        "scripture": "拘系之，乃從維之。王用亨于西山。"
      }
    ]
  },
